{
  "name": "clouddock",
  "productName": "CloudDock",
  "version": "1.4.8",
  "description": "多账号浏览器 — 同一网站登录多个账号，独立会话秒级切换",
  "author": "Dylan",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "package": "./scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
