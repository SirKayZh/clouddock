{
  "name": "clouddock",
  "productName": "CloudDock",
  "version": "1.4.7",
  "description": "多账号浏览器 — 同一网站登录多个账号，独立会话秒级切换",
  "author": "Dylan",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "package": "./scripts/package.sh"
  },
  "devDependencies": {
    "electron": "latest",
    "typescript": "latest",
    "@types/node": "latest"
  }
}
